[Version]
Signature="$Windows NT$"
Class=USB
ClassGuid={36FC9E60-C465-11CF-8056-444553540000}
Provider=%ProviderName%
DriverVer=09/30/2026,0.1.0.30
CatalogFile=VirKeyArm64.cat
PnpLockdown=1

[Manufacturer]
%ProviderName%=Models,NTarm64.10.0...26100

[Models.NTarm64.10.0...26100]
%KeyDescription%=HaspInstall,USB\Hasp

[DestinationDirs]
DriverCopy=13

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
VirKeyArm64.sys=1

[HaspInstall.NT]
CopyFiles=DriverCopy

[DriverCopy]
VirKeyArm64.sys

[HaspInstall.NT.Services]
AddService=akshasp,0x00000002,VirKeyHaspService

[VirKeyHaspService]
DisplayName=%KeyDescription%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\VirKeyArm64.sys

[HaspInstall.NT.Wdf]
KmdfService=akshasp,VirKeyWdf

[VirKeyWdf]
KmdfLibraryVersion=1.33

[Strings]
ProviderName="VirKeyArm64"
KeyDescription="Sentinel HASP Key"
DiskName="VirKeyArm64 HASP Child Driver Package"

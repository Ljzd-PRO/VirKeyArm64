[Version]
Signature="$Windows NT$"
Class=USB
ClassGuid={36FC9E60-C465-11CF-8056-444553540000}
Provider=%ProviderName%
DriverVer=09/30/2026,1.0.0.0
CatalogFile=VirKeyArm64.cat
PnpLockdown=1

[Manufacturer]
%ProviderName%=Models,NTarm64.10.0...26100

[Models.NTarm64.10.0...26100]
%ControllerDescription%=ControllerInstall,ROOT\VirKeyArm64
%KeyDescription%=KeyInstall,USB\VID_0529&PID_0001

[DestinationDirs]
DriverCopy=13

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
VirKeyArm64.sys=1

[ControllerInstall.NT]
CopyFiles=DriverCopy

[DriverCopy]
VirKeyArm64.sys

[ControllerInstall.NT.Services]
AddService=aksusb,0x00000002,VirKeyAksusbService

[ControllerInstall.NT.Wdf]
KmdfService=aksusb,VirKeyArm64Wdf

[KeyInstall.NT]
CopyFiles=DriverCopy

[KeyInstall.NT.Services]
AddService=aksusb,0x00000002,VirKeyAksusbService

[VirKeyAksusbService]
DisplayName=%KeyDescription%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\VirKeyArm64.sys
Dependencies=ucx01000,udecx

[KeyInstall.NT.Wdf]
KmdfService=aksusb,VirKeyArm64Wdf

[VirKeyArm64Wdf]
KmdfLibraryVersion=1.33

[Strings]
ProviderName="VirKeyArm64"
ControllerDescription="VirKeyArm64 Virtual USB Controller"
